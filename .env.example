# Copy to .env and adjust. .env is git-ignored.

# SSH target of the Home Assistant instance (user@host)
STATSTABLE_HOST=root@homeassistant.local

# SSH port (optional, default 22)
#STATSTABLE_SSH_PORT=22

# Home Assistant config directory on the instance (optional, default /config)
#STATSTABLE_CONFIG=/config

# Full target directory for the card (optional,
# default ${STATSTABLE_CONFIG}/www/community/ha-statistics-legend-table)
#STATSTABLE_TARGET=/config/www/community/ha-statistics-legend-table
