# Copy to .env and adjust. .env is git-ignored.

# SSH target of the Home Assistant instance (user@host)
ENERGYLEGEND_HOST=root@homeassistant.local

# SSH port (optional, default 22)
#ENERGYLEGEND_SSH_PORT=22

# Home Assistant config directory on the instance (optional, default /config)
#ENERGYLEGEND_CONFIG=/config

# Full target directory for the card (optional,
# default ${ENERGYLEGEND_CONFIG}/www/community/energy-custom-legend)
#ENERGYLEGEND_TARGET=/config/www/community/energy-custom-legend
